# Chave da API Gemini para Camada 4 (visao multimodal e conversa aberta) e fallback STT
GEMINI_API_KEY=

# Modelos opcionais (deixe comentado para usar a ordem automatica padrao)
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_PERSONA_MODEL=gemini-3.5-flash-lite
# GEMINI_STT_MODEL=gemini-3.5-flash-lite

# Modelo local opcional no Ollama para fallback de chat/visao offline (diferente de tev1)
# OLLAMA_CHAT_MODEL=gemma3:4b

# Voz offline Piper TTS em PT-BR (padrao: pt_BR-faber-medium)
# PIPER_VOICE=pt_BR-faber-medium
